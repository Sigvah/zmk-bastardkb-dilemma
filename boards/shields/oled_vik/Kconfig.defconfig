if SHIELD_OLED_VIK

config ZMK_DISPLAY
    default y

if ZMK_DISPLAY

# The animated screen in display/status_screen.c. Set this to n and set
# ZMK_DISPLAY_STATUS_SCREEN_BUILT_IN=y instead to fall back to ZMK's stock
# status screen, which is the quickest way to tell a rendering problem in
# the custom screen apart from a wiring or controller problem.
config DILEMMA_OLED_SCREEN
    default y

choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

# Keep display work off the system work queue. The ssd1306 write path is
# synchronous I2C, and a display that stalls or errors on the system queue
# starves the rest of the keyboard, killing key handling outright.
choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

if LVGL

# The panel is 1bpp. Without these LVGL defaults to 32 bits per pixel, which
# both mismatches the controller and sizes the buffers far past what the
# RP2040 has to spare.
config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

# A percentage of the display, not an absolute size. The panel is page
# addressed and the driver rejects any write whose origin is not a multiple
# of 8, so a partial buffer whose stripe height is not page aligned makes
# every flush fail. At 100 the buffer is the whole 128x128, which is 16
# whole pages and always aligned. 2KB for the buffer plus 2KB for the
# monochrome conversion buffer is affordable here.
config LV_Z_VDB_SIZE
    default 100

config LV_DPI_DEF
    default 148

endif # LVGL

endif # ZMK_DISPLAY

endif # SHIELD_OLED_VIK
