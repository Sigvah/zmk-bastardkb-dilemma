if SHIELD_OLED_VIK

config ZMK_DISPLAY
    default y

if ZMK_DISPLAY

# The animated screen in display/status_screen.c. Set this to n and set
# ZMK_DISPLAY_STATUS_SCREEN_BUILT_IN=y instead to fall back to ZMK's stock
# status screen, which is the quickest way to tell a rendering problem in
# the custom screen apart from a wiring or controller problem.
config DILEMMA_OLED_SCREEN
    default y

choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

if LVGL

# The panel is 1bpp. Without these LVGL defaults to 32 bits per pixel, which
# both mismatches the controller and sizes the buffers far past what the
# RP2040 has to spare.
config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

endif # LVGL

endif # ZMK_DISPLAY

endif # SHIELD_OLED_VIK
